{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://polis.dev/spec/v5/evidence-event.schema.json",
  "title":"POLIS Evidence Event v2",
  "$defs":{
    "gate":{"enum":["behavior","regression","affected","test.complete","coverage","lint","typecheck","build","smoke","compatibility","dependency","migration","security","platform","integrity","target-tree"]},
    "terminalStatus":{"enum":["PASS","FAIL","BLOCKED","NOT_APPLICABLE"]},
    "commandStatus":{"enum":["PASS","FAIL","BLOCKED"]},
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "oneOf":[
    {"type":"object","additionalProperties":false,"required":["event","gate"],"properties":{"event":{"const":"gate_started"},"gate":{"$ref":"#/$defs/gate"}}},
    {"type":"object","additionalProperties":false,"required":["event","gate","status","argv","cwd","exit_code","duration_ms","stdout_bytes","stderr_bytes","stdout_sha256","stderr_sha256","stdout_truncated","stderr_truncated"],"properties":{"event":{"const":"command_finished"},"gate":{"$ref":"#/$defs/gate"},"status":{"$ref":"#/$defs/commandStatus"},"argv":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"cwd":{"type":"string","minLength":1},"exit_code":{"type":"integer","minimum":-1},"duration_ms":{"type":"integer","minimum":0},"stdout_bytes":{"type":"integer","minimum":0},"stderr_bytes":{"type":"integer","minimum":0},"stdout_sha256":{"$ref":"#/$defs/sha256"},"stderr_sha256":{"$ref":"#/$defs/sha256"},"stdout_truncated":{"type":"boolean"},"stderr_truncated":{"type":"boolean"},"environment_mode":{"enum":["clean","inherit"]},"environment_pass":{"type":"array","uniqueItems":true,"items":{"type":"string"}}}},
    {"type":"object","additionalProperties":false,"required":["event","gate","status","oracle","oracle_index"],"properties":{"event":{"const":"oracle_checked"},"gate":{"const":"regression"},"status":{"const":"PASS"},"oracle":{"const":"baseline_output_contains"},"oracle_index":{"type":"integer","minimum":0}}},
    {"type":"object","additionalProperties":false,"required":["event","gate","status","adapter","report","metric","covered_lines","total_lines","value_percent","operator","threshold_percent"],"properties":{"event":{"const":"coverage_measured"},"gate":{"const":"coverage"},"status":{"enum":["PASS","FAIL"]},"adapter":{"enum":["go-coverprofile-v1","lcov-v1","cobertura-v1"]},"report":{"type":"string","minLength":1},"metric":{"const":"line_coverage_percent"},"covered_lines":{"type":"integer","minimum":0},"total_lines":{"type":"integer","minimum":1},"value_percent":{"type":"number","minimum":0,"maximum":100},"operator":{"const":">"},"threshold_percent":{"type":"number","minimum":80,"maximum":100}}},
    {"type":"object","additionalProperties":false,"required":["event","gate","status"],"properties":{"event":{"const":"gate_finished"},"gate":{"$ref":"#/$defs/gate"},"status":{"enum":["PASS","FAIL"]}}},
    {"type":"object","additionalProperties":false,"required":["event","gate","status","reason"],"properties":{"event":{"const":"gate_finished"},"gate":{"$ref":"#/$defs/gate"},"status":{"enum":["BLOCKED","NOT_APPLICABLE"]},"reason":{"type":"string","minLength":1}}}
  ]
}
