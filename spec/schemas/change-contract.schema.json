{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polis.dev/spec/v1/change-contract.schema.json",
  "title": "POLIS Change Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "behavior",
    "affected",
    "regression"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "feature",
        "defect",
        "behavior_preserving"
      ]
    },
    "behavior": {
      "$ref": "#/$defs/command"
    },
    "affected": {
      "$ref": "#/$defs/command"
    },
    "regression": {}
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd",
        "timeout_seconds"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "redGreen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "command",
        "baseline_exit_code",
        "baseline_output_contains"
      ],
      "properties": {
        "mode": {
          "const": "red_green"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "baseline_exit_code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "baseline_output_contains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notApplicable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "reason_code"
      ],
      "properties": {
        "mode": {
          "const": "not_applicable"
        },
        "reason_code": {
          "const": "not-a-defect"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "defect"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "regression": {
            "$ref": "#/$defs/redGreen"
          }
        }
      },
      "else": {
        "properties": {
          "regression": {
            "$ref": "#/$defs/notApplicable"
          }
        }
      }
    }
  ]
}
