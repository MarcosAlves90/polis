{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://polis.dev/spec/v5/change-contract.schema.json",
  "title":"POLIS Change Contract v2",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","kind","scope","behavior","affected","regression"],
  "properties":{
    "schema_version":{"const":2},
    "kind":{"enum":["feature","defect","behavior_preserving"]},
    "scope":{"$ref":"#/$defs/scope"},
    "behavior":{"$ref":"#/$defs/command"},
    "affected":{"$ref":"#/$defs/command"},
    "regression":{}
  },
  "$defs":{
    "scope":{"type":"object","additionalProperties":false,"required":["allowed_paths"],"properties":{"allowed_paths":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}}},
    "environment":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["mode"],"properties":{"mode":{"const":"inherit"}}},
      {"type":"object","additionalProperties":false,"required":["mode"],"properties":{"mode":{"const":"clean"},"pass":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]*$"}}}}
    ]},
    "command":{"type":"object","additionalProperties":false,"required":["argv","cwd","timeout_seconds","environment"],"properties":{"argv":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"cwd":{"type":"string","minLength":1},"timeout_seconds":{"type":"integer","minimum":1,"maximum":3600},"environment":{"$ref":"#/$defs/environment"}}},
    "redGreen":{"type":"object","additionalProperties":false,"required":["mode","command","baseline_exit_code","baseline_output_contains"],"properties":{"mode":{"const":"red_green"},"command":{"$ref":"#/$defs/command"},"baseline_exit_code":{"type":"integer","minimum":1,"maximum":255},"baseline_output_contains":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}}},
    "notApplicable":{"type":"object","additionalProperties":false,"required":["mode","reason_code"],"properties":{"mode":{"const":"not_applicable"},"reason_code":{"const":"not-a-defect"}}}
  },
  "allOf":[{"if":{"properties":{"kind":{"const":"defect"}},"required":["kind"]},"then":{"properties":{"regression":{"$ref":"#/$defs/redGreen"}}},"else":{"properties":{"regression":{"$ref":"#/$defs/notApplicable"}}}}]
}
