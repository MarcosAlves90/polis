{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polis.dev/spec/v5/change-contract-v4.schema.json",
  "title": "POLIS Locked Strict Change Contract v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "scope",
    "test_scope",
    "development_method",
    "specification",
    "baseline_lock",
    "behavior",
    "affected",
    "regression"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "kind": {
      "enum": [
        "feature",
        "defect",
        "behavior_preserving"
      ]
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "test_scope": {
      "$ref": "#/$defs/scope"
    },
    "specification": {
      "$ref": "#/$defs/specification"
    },
    "behavior": {
      "$ref": "#/$defs/command"
    },
    "affected": {
      "$ref": "#/$defs/command"
    },
    "regression": {},
    "development_method": {
      "const": "strict_sdd_tdd_v2"
    },
    "baseline_lock": {
      "$ref": "#/$defs/baselineLock"
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_paths"
      ],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "environment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "inherit"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "clean"
            },
            "pass": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            }
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd",
        "timeout_seconds",
        "environment"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "environment": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "inherit"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "clean"
                },
                "pass": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "requirements",
        "proof"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proof": {
          "const": "regression"
        }
      }
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "requirements",
        "acceptance_criteria",
        "invariants",
        "forbidden_states",
        "inputs",
        "outputs",
        "failure_semantics"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/clause"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/acceptanceCriterion"
          }
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/clause"
          }
        },
        "forbidden_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/clause"
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/clause"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/clause"
          }
        },
        "failure_semantics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/clause"
          }
        }
      }
    },
    "redGreen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "command",
        "baseline_exit_code",
        "baseline_output_contains"
      ],
      "properties": {
        "mode": {
          "const": "red_green"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "baseline_exit_code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "baseline_output_contains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "greenGreen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "command"
      ],
      "properties": {
        "mode": {
          "const": "green_green"
        },
        "command": {
          "$ref": "#/$defs/command"
        }
      }
    },
    "baselineLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_object_format",
        "base_commit",
        "base_tree",
        "policy_sha256",
        "specification_sha256"
      ],
      "properties": {
        "git_object_format": {
          "enum": [
            "sha1",
            "sha256"
          ]
        },
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "base_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "specification_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "git_object_format": {
                "const": "sha1"
              }
            }
          },
          "then": {
            "properties": {
              "base_commit": {
                "pattern": "^[0-9a-f]{40}$"
              },
              "base_tree": {
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "git_object_format": {
                "const": "sha256"
              }
            }
          },
          "then": {
            "properties": {
              "base_commit": {
                "pattern": "^[0-9a-f]{64}$"
              },
              "base_tree": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "feature",
              "defect"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "regression": {
            "$ref": "#/$defs/redGreen"
          }
        }
      },
      "else": {
        "properties": {
          "regression": {
            "$ref": "#/$defs/greenGreen"
          }
        }
      }
    }
  ]
}
